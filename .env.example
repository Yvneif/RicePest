# ---------------------------------------------------------------------------
# Rice Pest Identifier - backend configuration
# Copy to `ricepest-app/.env` and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# "development" | "production". In production, SECRET_KEY is REQUIRED.
FLASK_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# First admin account created by `flask seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Set to "true" when serving over HTTPS so session cookies get the Secure flag
COOKIE_SECURE=false

# Optional overrides (paths are resolved relative to ricepest-app/)
# DATABASE_URL=sqlite:///data/app.db
# DATA_DIR=data
# MODEL_PATH=models/my_trained_model6.keras
# MODEL_META_PATH=models/model_meta.json
# MAX_UPLOAD_MB=8
# RATE_LIMIT_PREDICT=30/hour
# FRONTEND_DIST=frontend/dist
